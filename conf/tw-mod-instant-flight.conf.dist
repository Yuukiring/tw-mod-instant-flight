###################################################################################################
# tw-mod-instant-flight module configuration
###################################################################################################

[InstantFlight]

# Enables instant flight teleport. When enabled, using a flight master teleports
# the player directly to the destination flight master for the normal flight cost.
# Set to 0 to disable and use the default flying behavior.
InstantFlight.Enable = 1

# Item required in the player's bags to activate instant flight. Accepts a single
# item id or a comma separated list of item ids. When the player does not carry
# any of them, the flight is handled by the default flying behavior instead.
# Set to 0 (default) to require no item.
InstantFlight.RequiredItemId = 0
